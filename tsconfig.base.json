{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@client/*": ["apps/gui/src/client/*"],
      "@app/*": ["apps/gui/src/client/app/*"],
      "@pages/*": ["apps/gui/src/client/app/pages/*"],
      "@layout/*": ["apps/gui/src/client/app/pages/layout/*"],
      "@shared/*": ["apps/gui/src/client/shared/*"],
      "@store/*": ["apps/gui/src/client/store/*"],
      "@assets/*": ["apps/gui/src/assets/*"]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}