# ========================================
# UniPass Environment Configuration
# Copy this file to .env and fill in the values.
# ========================================

# Node environment (development | production | test)
NODE_ENV=development

# Frontend port (Vite dev server)
FRONTEND_PORT=3000

# Backend port (Express API)
BACKEND_PORT=3001

# ========================================
# DATABASE (Neon Postgres)
# ========================================
# Get your connection string from https://neon.tech
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ========================================
# URLS
# ========================================
# Base URL of the API (used for OIDC discovery + issuer)
API_BASE_URL=http://localhost:3001

# Dev UI URL (used for CORS allowlist)
DEV_UI_URL=http://localhost:3000

# Production URL (used in OIDC discovery + CORS)
PRODUCTION_URL=https://your-app.onrender.com

# ========================================
# SECURITY
# ========================================
# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-in-production

# Access token lifetime (default 15m)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime (default 30d)
REFRESH_TOKEN_TTL=30d